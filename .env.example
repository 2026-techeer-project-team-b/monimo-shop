# 쇼핑몰 로컬 실행 설정 견본. 쓰려면 이 파일을 .env 로 복사한다 (.env 는 레포에 올라가지 않는다).
# 값을 비워 두면 docker-compose.dev.yml 의 기본값을 쓴다.
# 여기에는 로컬 개발용 값만 둔다. 실제 운영 비밀값 · mTLS 인증서는 절대 넣지 않는다.

# 호스트 포트 (다른 프로젝트와 겹칠 때만 바꾼다. 1로 시작하는 번호는 monimo-backend 와 같은 규칙)
# 기본 13306
MYSQL_PORT=
# 기본 8090 · 8091 · 8092 · 8093 (게이트웨이 · 주문 · 결제 · 재고)
GATEWAY_PORT=
ORDER_PORT=
PAYMENT_PORT=
INVENTORY_PORT=

# 로컬 MySQL 계정 (기본: 사용자 shop / 비밀번호 shop)
MYSQL_USER=
MYSQL_PASSWORD=

# 주문 서비스가 붙는 MySQL 호스트 · DB 이름 (bootRun 기준 기본 localhost · shop). compose 는 MYSQL_HOST 를 쓰지 않고 이미지 기본값 mysql 을 쓴다
MYSQL_HOST=
MYSQL_DATABASE=

# 결제 서비스가 부를 더미 외부 결제사(pg-stub) 주소 (bootRun 기준 기본 http://localhost:8099). compose 는 이미지 기본값 http://pg-stub:8080 을 쓴다
PG_BASE_URL=
# 결제사 스텁 호스트 포트 (기본 8099)
PG_STUB_PORT=

# 게이트웨이가 넘길 주문 서비스 주소 (bootRun 기준 기본 http://localhost:8091). compose 는 이미지 기본값 http://order:8091 을 쓴다
ORDER_BASE_URL=

# 주문 서비스가 부를 결제 서비스 주소 (bootRun 기준 기본 http://localhost:8092). compose 는 이미지 기본값 http://payment:8092 를 쓴다
PAYMENT_BASE_URL=

# OTel Java Agent 가 스팬 · 지표 · 로그를 보낼 수집기(monimo-backend collector) gRPC 주소
# 기본 http://collector:4317 (otel/agent.properties 와 같음, compose 가 monimo-dev 네트워크로 붙는다). 다른 수집기로 보낼 때만 넣는다
OTEL_EXPORTER_OTLP_ENDPOINT=
