{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/approvals",
    "headers": { "X-Shop-Fault": { "equalTo": "pg-slow" } }
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 1500,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "approvalId": "pg-{{randomValue length=8 type='ALPHANUMERIC' lowercase=true}}", "status": "APPROVED" },
    "transformers": ["response-template"]
  }
}
